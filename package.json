{
  "name": "pokeidle-panel",
  "productName": "PokeIdle Panel",
  "version": "0.1.1",
  "description": "Multi-account panel for PokeIdle with isolated sessions",
  "main": "./out/main/index.js",
  "author": "Gabriel Pinheiro",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/make-icon.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "electron-updater": "^6.8.9"
  }
}
